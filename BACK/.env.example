# Copy to .env in this BACK directory. The private .env file is ignored by Git.
# Start the backend from BACK; this file uses KEY=value syntax (no quotes or export).

# Groq setup: paste your free API key below (https://console.groq.com/keys).
# Collection photos and CV extraction use this provider.
COLLECTION_AI_PROVIDER=GROQ
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
GROQ_MODEL_TEXT=qwen/qwen3.8-27b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=60

# Assistant generation: GROQ uses GROQ_MODEL_TEXT and shares its free-plan quota.
# Set GEMINI to use GEMINI_MODEL_TEXT instead. No automatic provider fallback.
RAG_AI_PROVIDER=GROQ

# Gemini provides document/query embeddings and optional assistant generation.
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI

# Configurable generation models. Restart the backend after changing them.
GEMINI_MODEL_TEXT=gemini-3.8-flash
# Embeddings remain independent of text/vision model selection.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional alternative: only used when COLLECTION_AI_PROVIDER=OPENROUTER.
# Create a free API key at https://openrouter.ai/settings/keys and replace this placeholder.
OPENROUTER_API_KEY=VOTRE_CLE_OPENROUTER_ICI
OPENROUTER_MODEL_TEXT=qwen/qwen3.8-27b:free
OPENROUTER_MODEL_VISION=qwen/qwen3.8-27b:free
OPENROUTER_TIMEOUT_SECONDS=60

# Collection photo engine: LLM (provider above, default) or LOCAL (local model service,
# started with scripts/run-local-vision.bat or .sh). Rollback: VISION_ENGINE=LLM.
VISION_ENGINE=LLM
LOCAL_VISION_URL=http://127.0.0.1:8090
LOCAL_VISION_TIMEOUT_SECONDS=15
# Optional shared token; set the same value for the service and the backend.
LOCAL_VISION_TOKEN=
# Empty = always "A_VERIFIER" (human review). No default threshold is provided.
VISION_PROPRE_THRESHOLD=
# Image quality gate; empty = disabled.
# Exemples mesurés à l'étape 7 (mesuré sur des images synthétiques : optimiste, à recalibrer sur des photos réelles) :
#   VISION_MIN_SHARPNESS=118.68  (percentile 1 de la netteté sur 224 px des PROPRE/DEBORDEMENT réels de train)
#   VISION_MIN_BRIGHTNESS=30
VISION_MIN_SHARPNESS=
VISION_MIN_BRIGHTNESS=
VISION_MAX_BRIGHTNESS=

# Optional summary written by a language model for supervisors (LOCAL analyses only).
# TEMPLATE (default) = standard text, no model call. LLM = uses COLLECTION_AI_PROVIDER and its text model;
# it receives only the class, the three percentages, the decision, the quality issue, sharpness, brightness
# and the input mode, never the photo. Rollback: VISION_NARRATION=TEMPLATE.
VISION_NARRATION=TEMPLATE
VISION_NARRATION_TIMEOUT_SECONDS=10

# Optional: OpenRouteService key for live road routing.
ORS_API_KEY=

# Stable login signing secret. Generate once with: openssl rand -base64 32
# The local .env created during setup already contains a generated value.
JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET

# First startup only: create one supervisor account. Use at least 10 characters
# for the password, then set APP_BOOTSTRAP_ENABLED=false and restart.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_EMAIL=supervisor@example.test
APP_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Optional: create fixed test accounts (1 supervisor, 2 drivers) on startup.
# See "Test users" in the repository README for their credentials. Never enable in production.
APP_SEED_ENABLED=false
