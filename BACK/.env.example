# Copy to .env in this BACK directory. The private .env file is ignored by Git.
# Start the backend from BACK; this file uses KEY=value syntax (no quotes or export).

# Replace the placeholder below with your Google AI Studio Gemini API key.
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI

# Optional: OpenRouteService key for live road routing.
ORS_API_KEY=

# Stable login signing secret. Generate once with: openssl rand -base64 32
# The local .env created during setup already contains a generated value.
JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET

# First startup only: create one supervisor account. Use at least 10 characters
# for the password, then set APP_BOOTSTRAP_ENABLED=false and restart.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_EMAIL=supervisor@example.test
APP_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
